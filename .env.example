# Never commit your real .env.

# Any Ethereum Sepolia JSON-RPC endpoint.
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_RPC

# Test wallet only. Use a dedicated Sepolia wallet.
# Foundry accepts a hexadecimal private key as an integer.
PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY

# Fill this after running scripts/deploy_sepolia.sh
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Wallet that represents the business receiving revenue.
# For the first demo this can be another wallet you control.
BUSINESS_ADDRESS=0x0000000000000000000000000000000000000000

# USDC has 6 decimals.
# 1 USDC  = 1000000
# 10 USDC = 10000000
PAYMENT_AMOUNT=1000000

# Human-readable reference; PayRevenue hashes this into bytes32 paymentId.
PAYMENT_REF=flowcred-demo-payment-001
